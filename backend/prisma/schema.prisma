generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

enum SessionStatus {
  IN_PROGRESS
  COMPLETED
}

enum PathwayStatus {
  ACTIVE
  COMPLETED
}

enum MessageRole {
  ASSISTANT
  CAREGIVER
  SYSTEM
}

enum UserRole {
  CAREGIVER
  ORGANIZATION_ADMIN
}

enum LearningGuideStatus {
  DRAFT
  PUBLISHED
  ARCHIVED
}

enum VerifiedSourceStatus {
  PENDING
  APPROVED
  REJECTED
}

model User {
  id              String                  @id @default(uuid())
  fullName        String
  email           String                  @unique
  password        String
  role            UserRole                @default(CAREGIVER)
  organizationId  String?
  organization    HealthcareOrganization? @relation(fields: [organizationId], references: [id], onDelete: SetNull)
  uploadedGuides  LearningGuide[]         @relation("GuideUploader")
  addedSources    VerifiedSource[]        @relation("SourceCreator")
  approvedSources VerifiedSource[]        @relation("SourceApprover")
  patients        Patient[]
  recordedHealthcareSeekingEvents HealthcareSeekingEvent[] @relation("HealthcareSeekingRecorder")
  safetyQueries   SafetyQuery[]           @relation("UserSafetyQueries")
  createdAt       DateTime                @default(now())
  updatedAt       DateTime                @updatedAt

  @@map("users")
}

model HealthcareOrganization {
  id        String           @id @default(uuid())
  name      String           @unique
  users     User[]
  guides    LearningGuide[]
  sources   VerifiedSource[]
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt

  @@map("healthcare_organizations")
}

model LearningGuide {
  id              String                 @id @default(uuid())
  organizationId  String
  organization    HealthcareOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  uploadedById    String
  uploadedBy      User                   @relation("GuideUploader", fields: [uploadedById], references: [id], onDelete: Restrict)
  title           String
  prognosisVector String
  details         String
  tags            String[]               @default([])
  pdfObjectKey    String                 @unique
  pdfOriginalName String
  pdfSizeBytes    Int
  status          LearningGuideStatus    @default(DRAFT)
  sources         GuideSource[]
  createdAt       DateTime               @default(now())
  updatedAt       DateTime               @updatedAt

  @@index([organizationId, status, createdAt])
  @@index([prognosisVector])
  @@map("learning_guides")
}

model VerifiedSource {
  id             String                 @id @default(uuid())
  organizationId String
  organization   HealthcareOrganization @relation(fields: [organizationId], references: [id], onDelete: Cascade)
  createdById    String
  createdBy      User                   @relation("SourceCreator", fields: [createdById], references: [id], onDelete: Restrict)
  approvedById   String?
  approvedBy     User?                  @relation("SourceApprover", fields: [approvedById], references: [id], onDelete: SetNull)
  name           String
  url            String
  notes          String?
  status         VerifiedSourceStatus   @default(PENDING)
  approvedAt     DateTime?
  guides         GuideSource[]
  createdAt      DateTime               @default(now())
  updatedAt      DateTime               @updatedAt

  @@unique([organizationId, url])
  @@index([organizationId, status])
  @@map("verified_sources")
}

model GuideSource {
  guideId  String
  sourceId String
  guide    LearningGuide  @relation(fields: [guideId], references: [id], onDelete: Cascade)
  source   VerifiedSource @relation(fields: [sourceId], references: [id], onDelete: Cascade)

  @@id([guideId, sourceId])
  @@map("guide_sources")
}

model Patient {
  id                      String                  @id @default(uuid())
  caregiverId             String
  caregiver               User                    @relation(fields: [caregiverId], references: [id], onDelete: Cascade)
  fullName                String
  age                     Int
  gender                  String
  location                String?
  relationshipToCaregiver String
  onboardingSessions      OnboardingSession[]
  pathways                PatientPathway[]
  riskProfiles            RiskProfile[]
  safetyQueries           SafetyQuery[]
  microlearningMaterials  MicrolearningMaterial[]
  agentMemory             AgentMemory?
  agentMemoryRevisions    AgentMemoryRevision[]
  carePlans               CarePlan[]
  carePlanConversations   CarePlanConversation[]
  carePlanCheckIns        CarePlanCheckIn[]
  careFlags               CareFlag[]
  healthcareSeekingEvents HealthcareSeekingEvent[]
  createdAt               DateTime                @default(now())
  updatedAt               DateTime                @updatedAt

  @@index([caregiverId])
  @@map("patients")
}

model OnboardingSession {
  id          String              @id @default(uuid())
  patientId   String
  patient     Patient             @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status      SessionStatus       @default(IN_PROGRESS)
  messages    OnboardingMessage[]
  startedAt   DateTime            @default(now())
  completedAt DateTime?

  @@index([patientId])
  @@map("onboarding_sessions")
}

model OnboardingMessage {
  id        String            @id @default(uuid())
  sessionId String
  session   OnboardingSession @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  role      MessageRole
  content   String
  metadata  Json?
  createdAt DateTime          @default(now())

  @@index([sessionId])
  @@map("onboarding_messages")
}

// Centralized pathway registry, persisted so it can be inspected/edited
// without code changes. Source of truth at boot time is
// src/modules/discovery/rulesEngine/pathways.config.js, loaded by the seed script.
model ClinicalPathway {
  id            String   @id @default(uuid())
  name          String   @unique
  description   String
  configuration Json
  createdAt     DateTime @default(now())

  @@map("clinical_pathways")
}

model PatientPathway {
  id          String        @id @default(uuid())
  patientId   String
  patient     Patient       @relation(fields: [patientId], references: [id], onDelete: Cascade)
  pathwayName String
  status      PathwayStatus @default(ACTIVE)
  data        Json          @default("{}")
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([patientId, pathwayName])
  @@index([patientId])
  @@map("patient_pathways")
}

model RiskProfile {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  riskData  Json
  summary   String
  createdAt DateTime @default(now())

  @@index([patientId])
  @@map("risk_profiles")
}

// ── Phase 2: Safety Query ──────────────────────────────────────────────

enum SafetyQueryStatus {
  OPEN
  RED_FLAG_TRIGGERED
  CLOSED
}

enum QueryMessageRole {
  CHW
  ASSISTANT
}

model SafetyQuery {
  id          String               @id @default(uuid())
  patientId   String
  patient     Patient              @relation(fields: [patientId], references: [id], onDelete: Cascade)
  caregiverId String
  caregiver   User                 @relation("UserSafetyQueries", fields: [caregiverId], references: [id], onDelete: Cascade)
  title       String               @default("Safety Query")
  status      SafetyQueryStatus    @default(OPEN)
  messages    SafetyQueryMessage[]
  createdAt   DateTime             @default(now())
  updatedAt   DateTime             @updatedAt

  @@index([patientId])
  @@index([caregiverId])
  @@map("safety_queries")
}

model SafetyQueryMessage {
  id        String           @id @default(uuid())
  queryId   String
  query     SafetyQuery      @relation(fields: [queryId], references: [id], onDelete: Cascade)
  role      QueryMessageRole
  content   String
  // metadata: { isRedFlag, referralReason, linkedMaterialIds, linkedMaterialTitles }
  metadata  Json?
  createdAt DateTime         @default(now())

  @@index([queryId])
  @@map("safety_query_messages")
}

// ── Phase 2: Microlearning ─────────────────────────────────────────────

enum PreventionTrack {
  PRIMARY // prevent wound / entry formation
  SECONDARY // stop existing wound from progressing
  COMBINED // both Primary + Secondary running simultaneously
  GENERAL // not wound-specific (e.g., nutrition, caregiver support)
}

enum TargetAudience {
  CHW
  CAREGIVER
  BOTH
}

enum MaterialSource {
  SYSTEM_AUTO // auto-generated on risk profile completion
  CHW_REQUEST // CHW manually triggered generation
}

model MicrolearningMaterial {
  id                String          @id @default(uuid())
  patientId         String
  patient           Patient         @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title             String
  topic             String
  preventionTrack   PreventionTrack @default(GENERAL)
  targetAudience    TargetAudience  @default(BOTH)
  // Full structured content JSON:
  // { prescriptive[], prohibitive[], lowCostWorkarounds[], keySigns[], emergencyAction, summary }
  contentData       Json
  isAutoRecommended Boolean         @default(false)
  isAssigned        Boolean         @default(false)
  generatedBy       MaterialSource  @default(SYSTEM_AUTO)
  triggerContext    String?
  createdAt         DateTime        @default(now())

  @@index([patientId])
  @@map("microlearning_materials")
}

// Structured, durable patient-set memory used by the skill-led agent.
model AgentMemory {
  id        String   @id @default(uuid())
  patientId String   @unique
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      Json     @default("{}")
  updatedAt DateTime @updatedAt

  @@map("agent_memory")
}

model AgentMemoryRevision {
  id        String      @id @default(uuid())
  patientId String
  patient   Patient     @relation(fields: [patientId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime    @default(now())

  @@index([patientId, createdAt])
  @@map("agent_memory_revisions")
}

// Every revision is preserved; current plans never overwrite older ones.
model CarePlan {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  version   Int
  isCurrent Boolean  @default(true)
  title     String
  issue     String
  planData  Json
  createdAt DateTime @default(now())
  checkIns  CarePlanCheckIn[]

  @@unique([patientId, version])
  @@index([patientId, isCurrent])
  @@map("care_plans")
}

model CarePlanConversation {
  id        String            @id @default(uuid())
  patientId String
  patient   Patient           @relation(fields: [patientId], references: [id], onDelete: Cascade)
  status    String            @default("OPEN")
  messages  CarePlanMessage[]
  createdAt DateTime          @default(now())

  @@index([patientId, createdAt])
  @@map("care_plan_conversations")
}

model CarePlanMessage {
  id             String               @id @default(uuid())
  conversationId String
  conversation   CarePlanConversation @relation(fields: [conversationId], references: [id], onDelete: Cascade)
  role           String
  content        String
  createdAt      DateTime             @default(now())

  @@index([conversationId, createdAt])
  @@map("care_plan_messages")
}

model CarePlanCheckIn {
  id        String   @id @default(uuid())
  patientId String
  patient   Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  planId    String
  plan      CarePlan @relation(fields: [planId], references: [id], onDelete: Cascade)
  data      Json
  createdAt DateTime @default(now())

  @@index([patientId, createdAt])
  @@map("care_plan_check_ins")
}

model CareFlag {
  id           String   @id @default(uuid())
  patientId    String
  patient      Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  title        String
  status       String   @default("OPEN")
  epistemic    String   @default("suspected")
  evidence     Json
  doctorAsk    String
  prevention   Json
  outcome      String?
  createdAt    DateTime @default(now())
  resolvedAt   DateTime?

  @@index([patientId, status, createdAt])
  @@map("care_flags")
}

// Reported events measure the interval from warning-sign recognition to
// arrival at care. createdAt/arrivalRecordedAt capture entry times separately.
model HealthcareSeekingEvent {
  id                String   @id @default(uuid())
  patientId         String
  patient           Patient  @relation(fields: [patientId], references: [id], onDelete: Cascade)
  recordedById      String?
  recordedBy        User?    @relation("HealthcareSeekingRecorder", fields: [recordedById], references: [id], onDelete: SetNull)
  recognizedAt      DateTime
  arrivedAt         DateTime?
  arrivalRecordedAt DateTime?
  createdAt         DateTime @default(now())
  updatedAt         DateTime @updatedAt

  @@index([patientId, recognizedAt])
  @@index([recordedById, createdAt])
  @@map("healthcare_seeking_events")
}
