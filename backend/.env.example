PORT=5000
NODE_ENV=development

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/caregiver_sepsis_db?schema=public"

# JWT — signs the session token stored in the httpOnly cookie
JWT_SECRET="replace-with-a-long-random-string-openssl-rand-base64-48"
# Duration string: 2h, 8h, 1d, 7d, etc. Cookie maxAge is derived automatically.
JWT_EXPIRES_IN="2h"

# Gemini
GEMINI_API_KEY="YOUR_GEMINI_KEY"
GEMINI_MODEL="gemini-3.8-flash"

# CORS — must exactly match the frontend's origin (no trailing slash).
# credentials:true is already set on the server; this controls which origin
# is allowed to make credentialed requests (i.e. send the httpOnly cookie).
CORS_ORIGIN="http://localhost:5173"

# ── Cookie security ────────────────────────────────────────────────────────
# These are derived from NODE_ENV automatically in env.js; you only need to
# set them here if you want to override the defaults:
#
#   NODE_ENV=development  →  secure=false, sameSite=lax
#   NODE_ENV=production   →  secure=true,  sameSite=none
#
# SameSite=None is required when your frontend and backend are on different
# domains (e.g. app.vercel.app + api.railway.app).
# SameSite=None REQUIRES secure=true (HTTPS). Most production hosts
# (Render, Railway, Heroku, Vercel) terminate TLS for you.
